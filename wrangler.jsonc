{
  // Notearkiv — skanning, lagring og visning på notearkiv.jortech.no
  "name": "notearkiv",
  "main": "worker/src/worker.js",
  "compatibility_date": "2025-06-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },

  // Notesider og PDF-er ligger i R2: store, uforanderlige filer som
  // serveres med lang cache. Bøtta er opprettet i EU-jurisdiksjonen,
  // så bindingen må si det — uten "jurisdiction" finner wrangler den ikke.
  "r2_buckets": [
    { "binding": "FILER", "bucket_name": "notearkiv", "jurisdiction": "eu" }
  ],

  // Katalogen blir derimot liggende i KV. Den er liten (~85 kB) og leses
  // ved hvert eneste sidelast, og det er akkurat det KV er bygget for.
  "kv_namespaces": [
    { "binding": "NOTER", "id": "6dbeec950d5f42d7af7cb5a45b4e3660" }
  ],

  // Notegjenkjenninga kan ikke bo i en Worker: modellene er 150 MB og
  // trenger Python. Den kjoerer derfor som en container ved siden av,
  // og vaakner bare naar noen skanner noe. Maalt paa en ekte side:
  // 3,7 sekunder, som gir rundt 6000 sider i maaneden innenfor det
  // Workers Paid inkluderer.
  //
  // Imaget bygges av Cloudflare Workers Builds fra dette lageret.
  // «wrangler deploy» herfra krever Docker lokalt og vil feile uten.
  "containers": [
    {
      "class_name": "Notegjenkjenner",
      // Peker paa selve Dockerfilen, ikke mappa: wrangler avviser en
      // katalog her. Byggekonteksten blir mappa fila ligger i, saa
      // «COPY server.py» finner den fortsatt.
      "image": "./container/Dockerfile",
      "instance_type": "standard-2",
      "max_instances": 3
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "GJENKJENNER", "class_name": "Notegjenkjenner" }
    ]
  },
  "exports": {
    "Notegjenkjenner": { "type": "durable-object", "storage": "sqlite" }
  },

  "routes": [
    { "pattern": "notearkiv.jortech.no", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
